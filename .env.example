# -----------------------------------------------------------------------------
# Marketplace environment template. Copy to .env and fill in. Never commit .env.
# Full inventory and portability rules: docs/architecture/11-domain-migration-and-portability.md §2
# -----------------------------------------------------------------------------

# --- App ---------------------------------------------------------------------
APP_NAME=Marketplace
APP_ENV=local
# Generate with `php artisan key:generate`. NEVER change it after launch or across
# hosting/domain migrations: it decrypts 2FA secrets and signed data.
APP_KEY=
APP_DEBUG=true
# The only canonical host. Production example: https://marketplace.example.com
APP_URL=http://localhost:8000
# Optional, migration only: comma-separated extra hosts trusted temporarily.
APP_ALIASES=
# Optional CDN for built assets.
ASSET_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
# Production: LOG_CHANNEL=daily, LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database ----------------------------------------------------------------
# Local default is SQLite (database/database.sqlite). MySQL 8.0+/MariaDB 10.6+ in
# staging/production, each with its own database and least-privilege user.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=marketplace
# DB_USERNAME=marketplace
# DB_PASSWORD=

# --- Session / cache / queue -------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-only cookie: keep null. Never share cookies with other sites.
SESSION_DOMAIN=null
SESSION_COOKIE=dtm_session
# Production: true (HTTPS only)
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
CACHE_STORE=file
# CACHE_PREFIX=
QUEUE_CONNECTION=database

# Future (VPS): REDIS_CLIENT=phpredis REDIS_HOST=127.0.0.1 REDIS_PASSWORD=null REDIS_PORT=6379

# --- Storage and images ------------------------------------------------------
FILESYSTEM_DISK=local
# Listing images disk: `local` (storage/app/public/listings via public/storage symlink),
# `uploads` (public/uploads/listings, for hosts without symlinks) or `s3` (object storage).
LISTINGS_DISK_DRIVER=local
LISTINGS_ROOT=
# Public base URL for listing images (empty = derived from APP_URL).
LISTINGS_URL=
# gd (default) or imagick
IMAGE_DRIVER=gd
# webp (default) or jpg (when GD lacks WebP)
IMAGE_FORMAT=webp

# Object storage (later, S3-compatible e.g. Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail --------------------------------------------------------------------
# Development: log or host SMTP. Production provider is configured here only.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Production stays false until deliverability is verified (CD-09). false = mail goes to the log.
MAIL_SENDING_ENABLED=false
# Keep ~10 below the host's hourly limit.
MAIL_HOURLY_LIMIT=80

# --- Security ----------------------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Set when behind a proxy/CDN (e.g. Cloudflare), comma-separated IPs/CIDRs or *
TRUSTED_PROXIES=

# --- Background work (hosts without an every-minute cron) --------------------
WEB_RUNNER_ENABLED=false
WEB_RUNNER_INTERVAL=60
WEB_RUNNER_MAX_SECONDS=15

# --- SEO ---------------------------------------------------------------------
# false on staging: adds noindex and a disallow-all robots.txt
SEO_INDEXING=false

# --- Marketplace defaults (see config/marketplace.php) -----------------------
MARKETPLACE_DEFAULT_COUNTRY=LK
MARKETPLACE_LISTING_EXPIRY_DAYS=60
MARKETPLACE_MAX_ACTIVE_LISTINGS=50
MARKETPLACE_MAX_NEW_LISTINGS_PER_DAY=10
MARKETPLACE_MODERATION_MODE=all

VITE_APP_NAME="${APP_NAME}"
